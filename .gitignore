# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
.eggs/
*.egg-info/
pip-wheel-metadata/

# Test, lint, and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Notebook checkpoints
.ipynb_checkpoints/

# Local environment files
.env
.env.*
.python-version
.codex

# Editor / OS noise
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Project runtime outputs generated by the demo and GUI scripts
outputs/

# Local lab data. Raw recordings can contain participant EEG and are large.
# Ignore everything under data/ EXCEPT derived artifacts, which are committed.
lab_data/
data/*
!data/.gitkeep
!data/derived/

# Large binary / tensor / archive artifacts (never commit raw ones).
# Derived artifacts under data/derived/ are re-included explicitly below.
*.pt
*.pth
*.zip
!data/derived/**

# Local model weights / checkpoints
checkpoints/

# Raw EEG / experiment recordings
*.nedf
*.easy
*.xdf
*.edf
*.bdf
*.set
*.fdt
*.vhdr
*.vmrk
*.eeg
*.psydat

# Model/checkpoint artifacts outside checkpoints/
*.ckpt
*.safetensors
*.onnx
*.engine
*.plan

# Training experiment outputs
runs/
wandb/
lightning_logs/

# Local logs and generic caches
*.log
.cache/
